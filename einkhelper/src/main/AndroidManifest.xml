<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para ver se a Skriba esta instalada e a abrir -->
    <queries>
        <package android:name="pt.flick.skriba" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light">
        <activity
            android:name=".HelperActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Caneta rapida para a Skriba (so aceita a Skriba: ver InkBridgeService.callerAllowed) -->
        <service
            android:name=".InkBridgeService"
            android:exported="true" />
    </application>

</manifest>
